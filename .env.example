# 复制为 .env 后填写；不要提交 .env。
# 两个口令分别生成，例如：openssl rand -base64 24

# 浏览器访问端口；80 被占用时改成 8088 等。
YUMI_HTTP_PORT=80

# 业务库
YUMI_DB_NAME=yumi_v2
YUMI_DB_USER=yumi
YUMI_DB_PASSWORD=replace-with-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-password

# MySQL 镜像标签；内网无法拉取固定小版本时可改用已缓存的 8.4。
YUMI_MYSQL_TAG=8.4.11

# 镜像标签；升级或回滚时改成不同值，便于保留上一版镜像。
YUMI_VERSION=latest
